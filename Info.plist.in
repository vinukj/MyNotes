<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.vinayjagtap.mynotes</string>
<key>CFBundleName</key><string>MyNotes</string>
<key>CFBundleDisplayName</key><string>MyNotes</string>
<key>CFBundleExecutable</key><string>MyNotes</string>
<key>CFBundleIconFile</key><string>AppIcon</string>
<key>CFBundleIconName</key><string>AppIcon</string>
<key>CFBundlePackageType</key><string>APPL</string>
